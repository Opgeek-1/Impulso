generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  password      String?
  accounts      Account[]
  sessions      Session[]
  projects      Project[]
  memberships   WorkspaceMember[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  projectId         String?
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  project           Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@id([provider, providerAccountId])
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
}

model Project {
  id          String   @id @default(cuid())
  name        String
  handle      String
  description String?
  brief       String?
  avatarUrl   String?
  brandLogoUrl    String?
  brandColors     String?
  brandAssetsNote String?
  xProviderAccountId String?
  xUsername String?
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  accounts    Account[]
  tweets      Tweet[]
  styles      Style[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Style {
  id        String   @id @default(cuid())
  name      String
  content   String
  isDefault Boolean  @default(false)
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Tweet {
  id              String      @id @default(cuid())
  content         String
  designBrief     String?
  imageUrl        String?
  imagePrompt     String?
  status          TweetStatus @default(DRAFT)
  scheduledAt     DateTime?
  externalPostId  String?
  publishedAt     DateTime?
  publishError    String?
  publishAttempts Int         @default(0)
  lastPublishAttemptAt DateTime?
  projectId       String
  project         Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  batchId         String?
  batch           Batch?      @relation(fields: [batchId], references: [id])
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
}

model Batch {
  id        String   @id @default(cuid())
  name      String
  tweets    Tweet[]
  createdAt DateTime @default(now())
}

enum TweetStatus {
  DRAFT
  CURATED
  DESIGNED
  IMAGE_GENERATED
  SCHEDULED
  PUBLISHING
  PUBLISH_FAILED
  POSTED
}

model Workspace {
  id        String            @id @default(cuid())
  name      String
  domain    String?
  plan      String            @default("free")
  seats     Int               @default(8)
  members   WorkspaceMember[]
  invites   WorkspaceInvite[]
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
}

model WorkspaceMember {
  id          String    @id @default(cuid())
  role        String    @default("member")
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  lastActive  DateTime  @default(now())
  createdAt   DateTime  @default(now())

  @@unique([userId, workspaceId])
}

model WorkspaceInvite {
  id          String    @id @default(cuid())
  email       String?
  token       String    @unique @default(cuid())
  role        String    @default("member")
  expiresAt   DateTime?
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())
}
