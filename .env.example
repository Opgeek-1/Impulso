# ── Auth (required) ──────────────────────────────────────
# Generate with: openssl rand -base64 32
AUTH_SECRET=
AUTH_URL=http://localhost:3000

# ── Database (required) ──────────────────────────────────
DATABASE_URL=postgresql://user:password@localhost:5432/impulso
# POSTGRES_PRISMA_URL=  # Vercel Postgres (optional, falls back to DATABASE_URL)

# ── Twitter / X OAuth (optional — enables X login and publishing) ─
AUTH_TWITTER_ID=
AUTH_TWITTER_SECRET=

# ── AI (required for content generation) ─────────────────
AI_API_BASE_URL=       # e.g. https://api.openai.com/v1
AI_API_KEY=

# ── AI Models (optional — defaults shown) ────────────────
# AI_TWEET_MODEL=claude-sonnet-4-6
# AI_DESIGN_MODEL=claude-sonnet-4-6
# AI_IMAGE_MODEL=gpt-image-2
# AI_IMAGE_FALLBACK_MODEL=gemini-2.5-flash-image

# ── Email (optional — enables email-code login) ─────────
# RESEND_API_KEY=

# ── Cron (optional — secures scheduled publish endpoint) ─
# CRON_SECRET=
